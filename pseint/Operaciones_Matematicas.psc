Algoritmo Operaciones_Matematicas
    Definir N1,N2,Suma,Resta,Multiplicacion,Division,Modulo Como Real
	
    N1 <- 0
    N2 <- 0
	
    Escribir "Digite el primer número:"
    Leer N1
	
    Escribir "Digite el segundo número:"
    Leer N2
	
    Suma <- N1 + N2
    Resta <- N1 - N2
    Multiplicacion <- N1 * N2
    Division <- N1 / N2
    Modulo <- N1 MOD N2
	
    Escribir "La suma es: ", Suma
    Escribir "La resta es: ", Resta
    Escribir "La multiplicación es: ", Multiplicacion
    Escribir "La división es: ", Division
    Escribir "El módulo o residuo es: ", Modulo
	
FinAlgoritmo
