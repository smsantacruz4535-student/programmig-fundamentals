Algoritmo student_grades 
	DEFINIR n1, n2, n3, def Como Real 
	Definir fullname Como caracter 
	
	n1 <-0
	n2 <-0
	n3 <-0
	def <-0
	fullname <-""
	Escribir "Type fullname"
	leer fullname 
	Escribir "Type N1: "
	Leer n1
	Escribir "Type N2: "
	Leer n2
	Escribir "Type N3: "
	Leer n3
	
	def <-n1*0.3 + n2*0.3 + n3*0.4
	Escribir "final grade is: ", def
FinAlgoritmo
