Algoritmo Conversion_Horas
    Definir Horas,Minutos,Segundos Como Real
	
    Horas <- 0
    Minutos <- 0
    Segundos <- 0
	
    Escribir "Digite la cantidad de horas:"
    Leer Horas
	
    Minutos <- Horas * 60
    Segundos <- Horas * 3600
	
    Escribir "La cantidad de minutos es: ", Minutos
    Escribir "La cantidad de segundos es: ", Segundos
	
FinAlgoritmo
