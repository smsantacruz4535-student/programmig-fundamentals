Algoritmo  Conversion_Celsius_Fahrenheit
    Definir Celsius,Fahrenheit Como Real
	
    Celsius <- 0
    Fahrenheit <- 0
	
    Escribir "Digite la temperatura en grados Celsius:"
    Leer Celsius
	
    Fahrenheit <- (Celsius * 9 / 5) + 32
	
    Escribir "La temperatura en Fahrenheit es: ", Fahrenheit
	
FinAlgoritmo
