Algoritmo Conversion_Kilometros_Metros
    Definir Kilometros,Metros Como Real
	
    Kilometros <- 0
    Metros <- 0
	
    Escribir "Digite la distancia en kilómetros:"
    Leer Kilometros
	
    Metros <- Kilometros * 1000
	
    Escribir "La distancia en metros es: ", Metros
	
FinAlgoritmo
